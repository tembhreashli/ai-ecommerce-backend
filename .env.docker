# Docker-specific environment variables
# These are optimized for running the application in Docker containers

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_ecommerce
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Application Configuration
SERVER_PORT=9090
JWT_SECRET=your-secret-key-change-in-production-with-at-least-256-bits-long

# Spring Profile
SPRING_PROFILES_ACTIVE=docker

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ECOMMERCE=DEBUG
